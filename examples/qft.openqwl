openqwl: "0.1"

metadata:
  id: qft
  name: Quantum Fourier Transform
  version: "1.0"
  author: Quantag IT Solutions GmbH

problem:
  domain: circuits
  type: qft
  formal_model: quantum_circuit

workflow:
  nodes:
    - id: create_qft
      uses: openqwl://stdlib/circuits/qft
      outputs:
        circuit: qft_circuit
      parameters:
        qubits: 4

    - id: export_qasm
      uses: openqwl://stdlib/export/qasm
      inputs:
        circuit: qft_circuit
      outputs:
        file: qasm_file
      parameters:
        format: openqasm3
        path: output/qft.qasm

  edges:
    - from: create_qft
      to: export_qasm
      output: qft_circuit
      input: circuit

exports:
  qasm:
    format: openqasm3
    path: output/qft.qasm

metrics:
  - qubit_count
  - gate_count
  - circuit_depth
