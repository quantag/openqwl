openqwl: "0.1"

metadata:
  id: bell-state
  name: Bell State Workflow
  version: "1.0"
  author: Quantag IT Solutions GmbH
  license: Apache-2.0

problem:
  domain: circuits
  type: bell_state
  formal_model: quantum_circuit

workflow:
  nodes:
    - id: create_bell
      uses: openqwl://stdlib/circuits/bell
      outputs:
        circuit: bell_circuit
      parameters:
        qubits: 2

    - id: export_qasm
      uses: openqwl://stdlib/export/qasm
      inputs:
        circuit: bell_circuit
      outputs:
        file: bell_qasm
      parameters:
        format: openqasm3
        path: output/bell.qasm

  edges:
    - from: create_bell
      to: export_qasm
      output: circuit
      input: circuit

exports:
  qasm:
    format: openqasm3
    path: output/bell.qasm

metrics:
  - qubit_count
  - gate_count
  - circuit_depth
