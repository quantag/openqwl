openqwl: "0.1"

metadata:
  id: teleportation
  name: Quantum Teleportation
  version: "1.0"
  author: Quantag IT Solutions GmbH

problem:
  domain: circuits
  type: teleportation
  formal_model: quantum_circuit

workflow:
  nodes:
    - id: create_teleport
      uses: openqwl://stdlib/circuits/teleportation
      outputs:
        circuit: teleport_circuit

    - id: export_qasm
      uses: openqwl://stdlib/export/qasm
      inputs:
        circuit: teleport_circuit
      outputs:
        file: qasm_file
      parameters:
        format: openqasm3
        path: output/teleportation.qasm

  edges:
    - from: create_teleport
      to: export_qasm
      output: teleport_circuit
      input: circuit

exports:
  qasm:
    format: openqasm3
    path: output/teleportation.qasm

metrics:
  - qubit_count
  - gate_count
  - circuit_depth
