openqwl: "0.1"

metadata:
  id: grover-search
  name: Grover Search
  version: "1.0"
  author: Quantag IT Solutions GmbH
  license: Apache-2.0

problem:
  domain: search
  type: grover
  complexity: O(sqrt(N))

workflow:
  nodes:

    - id: oracle
      uses: openqwl://stdlib/search/oracle
      outputs:
        oracle: oracle
      parameters:
        target: "101"

    - id: diffuser
      uses: openqwl://stdlib/search/diffuser
      outputs:
        diffuser: diffuser
      parameters:
        qubits: 3

    - id: grover
      uses: openqwl://stdlib/search/grover
      inputs:
        oracle: oracle
        diffuser: diffuser
      outputs:
        circuit: circuit
      parameters:
        iterations: auto

    - id: export_qasm
      uses: openqwl://stdlib/export/qasm
      inputs:
        circuit: circuit
      outputs:
        file: grover_qasm
      parameters:
        format: openqasm3
        path: output/grover.qasm

  edges:
    - from: oracle
      to: grover
      output: oracle
      input: oracle

    - from: diffuser
      to: grover
      output: diffuser
      input: diffuser

    - from: grover
      to: export_qasm
      output: circuit
      input: circuit

exports:
  qasm:
    format: openqasm3
    path: output/grover.qasm

metrics:
  - qubit_count
  - gate_count
  - circuit_depth